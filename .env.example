# Supabase project "otto" (Project Settings > API). Publishable key = the old "anon" key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Secret key = the old "service_role" key. Never prefix with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# Web Push. Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret pg_cron sends to /api/cron/tick. Any long random string.
CRON_SECRET=

# Optional: email fallback for the 08:00 summary when push hasn't delivered in 24h.
RESEND_API_KEY=
RESEND_FROM=Otto <otto@yourdomain.com>
